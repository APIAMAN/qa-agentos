# QA AgentOS Production Caddy Configuration

{$DOMAIN_NAME:localhost} {
    # Reverse proxy API endpoints to FastAPI application
    handle /v1/* {
        reverse_proxy api:8000
    }

    # Reverse proxy auth/health endpoints to FastAPI application
    handle /health {
        reverse_proxy api:8000
    }

    # Reverse proxy all other console traffic to Next.js frontend
    handle {
        reverse_proxy frontend:3000
    }
}
