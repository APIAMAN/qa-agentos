# QA AgentOS Environment Configuration Baseline
ENVIRONMENT=development
PROJECT_NAME="QA AgentOS"

# Security & Auth Keys
SECRET_KEY=dev-secret-key-change-this-in-production-min-32-chars-long
JWT_ALGORITHM=RS256
# In dev, auto-generated RSA keys will be used if RSA_PRIVATE_KEY_PEM / RSA_PUBLIC_KEY_PEM are unset
RSA_PRIVATE_KEY_PEM=
RSA_PUBLIC_KEY_PEM=

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=qa_agentos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qa_agentos

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Artifact Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=qa-agentos-artifacts
MINIO_SECURE=false

# Hatchet Queue Engine
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_TLS_STRATEGY=none

# LiteLLM Proxy / Gateway
LITELLM_ENDPOINT=http://localhost:4000
LITELLM_MASTER_KEY=sk-litellm-dev-master-key
NVIDIA_NIM_API_KEY=
# Google Gemini (LLM classifier alias and, when enabled, embeddings). Placeholder only; never commit a key.
GEMINI_API_KEY= 

# Langfuse Observability (Optional for M0)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Next.js Frontend Config
NEXT_PUBLIC_API_URL=http://localhost:8000

# M3 Bug Analyzer: embeddings + duplicate detection (docs/m3/BUG_ANALYZER.md)
# Disabled by default (no provider calls, no spend). D1: Gemini gemini-embedding-001, 1536 dims,
# SEMANTIC_SIMILARITY (set on the LiteLLM alias). Enabling requires a positive EMBEDDING_COST_PER_1M_TOKENS
# (standard tier 0.15 USD per 1M input tokens as of 2026-11-25; re-check the Gemini pricing page).
# EMBEDDINGS_ENABLED=false
# EMBEDDING_PROVIDER=gateway            # gateway | fake (tests/evals only)
# EMBEDDING_GATEWAY_MODEL_KEY=embedder  # LiteLLM alias in deploy/litellm/config.yaml
# EMBEDDING_MODEL_IDENTITY=gemini/gemini-embedding-001:SEMANTIC_SIMILARITY
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_REQUEST_DIMENSIONS=false
# EMBEDDING_INPUT_TYPE=                # leave empty for Gemini (task type is set on the LiteLLM alias)
# EMBEDDING_TIMEOUT_SECONDS=15
# EMBEDDING_COST_PER_1M_TOKENS=        # required (> 0) when enabled with the gateway; from the price list
# DUPLICATE_SIMILARITY_THRESHOLD=0.95   # initial Gemini calibration (docs/m3/BUG_ANALYZER.md §5)

# M3 agent evaluations (docs/m3/EVALS.md); used by evals/run.py, not by the app
# EVAL_JUDGE_MODEL_KEY=                 # LiteLLM alias of the pinned G-Eval judge (D2 open)
# EVAL_MAX_COST_USD=2.00
