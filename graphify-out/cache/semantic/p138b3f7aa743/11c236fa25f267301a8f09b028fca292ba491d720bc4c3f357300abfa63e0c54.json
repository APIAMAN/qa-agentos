{"nodes": [{"id": "docs_research_qa_agentos_architecture_doc", "label": "QA AgentOS Architecture & Design Dossier", "file_type": "document", "source_file": "docs/research/QA_AGENTOS_ARCHITECTURE.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_qa_agentos_architecture_modular_monolith", "label": "FastAPI Modular Monolith", "file_type": "rationale", "source_file": "docs/research/QA_AGENTOS_ARCHITECTURE.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Solo maintainability; workers are the only scale axis; modules are future split lines (ADR-001)"}, {"id": "docs_research_qa_agentos_architecture_agent_registry", "label": "Agent Registry", "file_type": "concept", "source_file": "docs/research/QA_AGENTOS_ARCHITECTURE.md", "source_location": "L601", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agents are data + execution template so new agents are added without rewriting the platform; active versions immutable for replay fidelity"}, {"id": "docs_research_qa_agentos_architecture_tool_registry", "label": "Tool Registry", "file_type": "concept", "source_file": "docs/research/QA_AGENTOS_ARCHITECTURE.md", "source_location": "L654", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every tool has one contract (JSON Schema I/O, permissions, timeout, retry) so bad args never execute and garbage never reaches agents"}, {"id": "docs_research_qa_agentos_architecture_tool_dispatch_pipeline", "label": "Tool Dispatch Pipeline", "file_type": "rationale", "source_file": "docs/research/QA_AGENTOS_ARCHITECTURE.md", "source_location": "L679", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "validate -> permission -> rate limit -> timeout -> retry -> validate output -> record; typed errors let agents reason about failures"}, {"id": "docs_research_qa_agentos_architecture_model_registry", "label": "Model Registry", "file_type": "concept", "source_file": "docs/research/QA_AGENTOS_ARCHITECTURE.md", "source_location": "L330", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Model IDs live in DB rows + gateway config, never in agent code, to absorb NVIDIA catalog churn"}, {"id": "docs_research_qa_agentos_architecture_capability_slots", "label": "Capability Slots (agents request capabilities, not models)", "file_type": "rationale", "source_file": "docs/research/QA_AGENTOS_ARCHITECTURE.md", "source_location": "L330", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decouple agents from models; provider outage becomes a routing event, not a deploy"}, {"id": "docs_research_qa_agentos_architecture_langgraph_runtime", "label": "Generic LangGraph Agent Runtime", "file_type": "concept", "source_file": "docs/research/QA_AGENTOS_ARCHITECTURE.md", "source_location": "L46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over CrewAI for determinism, auditability, interrupt() approvals, token efficiency (ADR-002); graphs kept thin for Pydantic AI escape hatch"}, {"id": "docs_research_qa_agentos_architecture_generic_react_graph", "label": "generic_react Graph Template", "file_type": "concept", "source_file": "docs/research/QA_AGENTOS_ARCHITECTURE.md", "source_location": "L961", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_qa_agentos_architecture_postgres_checkpointer", "label": "LangGraph Postgres Checkpointer", "file_type": "concept", "source_file": "docs/research/QA_AGENTOS_ARCHITECTURE.md", "source_location": "L290", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "thread_id = run_id makes runs resumable and replayable"}, {"id": "docs_research_qa_agentos_architecture_litellm_gateway", "label": "LiteLLM Model Gateway", "file_type": "concept", "source_file": "docs/research/QA_AGENTOS_ARCHITECTURE.md", "source_location": "L50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only model endpoint in the system; provider swap = config; owns resilience (fallback chains) and metering (ADR-004)"}, {"id": "docs_research_qa_agentos_architecture_nvidia_nim", "label": "NVIDIA Hosted NIM", "file_type": "concept", "source_file": "docs/research/QA_AGENTOS_ARCHITECTURE.md", "source_location": "L337", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Primary provider for dev economics; free tier (~1000 credits, ~40 RPM) is a dev accelerator, not production (ADR-005)"}, {"id": "docs_research_qa_agentos_architecture_gemini", "label": "Google Gemini", "file_type": "concept", "source_file": "docs/research/QA_AGENTOS_ARCHITECTURE.md", "source_location": "L90", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_qa_agentos_architecture_hatchet", "label": "Hatchet Durable Task Queue", "file_type": "concept", "source_file": "docs/research/QA_AGENTOS_ARCHITECTURE.md", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Postgres-native, durable, fair queuing, rate limits; chosen over Celery/Redis and Temporal to avoid new stateful infra (ADR-006)"}, {"id": "docs_research_qa_agentos_architecture_postgresql", "label": "PostgreSQL 17 + JSONB", "file_type": "concept", "source_file": "docs/research/QA_AGENTOS_ARCHITECTURE.md", "source_location": "L53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "System of record for everything relational; MongoDB rejected for transactional integrity (ADR-007)"}, {"id": "docs_research_qa_agentos_architecture_pgvector", "label": "pgvector", "file_type": "concept", "source_fi